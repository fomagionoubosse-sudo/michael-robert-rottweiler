<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin Dashboard | Michael Robert</title><link rel="stylesheet" href="/style.css"></head><body class="adminpage"><header><nav><a class="brand" href="/">MICHAEL ROBERT<small>ADMIN DASHBOARD</small></a><div class="links"><a href="/" target="_blank">View Website</a><form method="post" action="/admin/logout"><button class="logout">Log out</button></form></div></nav></header><main class="dashboard"><h1>Dashboard</h1><p class="notice"><%= message %></p><section class="panel"><h2>Add Puppy</h2><form class="formgrid" action="/admin/puppies/add" method="post" enctype="multipart/form-data"><label>Name<input name="name" required></label><label>Gender<select name="gender"><option>Male</option><option>Female</option></select></label><label>Age<input name="age" placeholder="10 weeks" required></label><label>Price<input name="price" placeholder="$1,800" required></label><label>Status<select name="status"><option>Available</option><option>Reserved</option><option>Adopted</option></select></label><label>Photo<input type="file" name="image" accept="image/*"></label><label class="wide">Description<textarea name="description"></textarea></label><button class="button" type="submit">Add Puppy</button></form></section>
<section class="panel"><h2>Manage Puppies</h2><div class="adminlist"><% puppies.forEach(p => { %><form class="adminitem" action="/admin/puppies/<%= p.id %>/edit" method="post" enctype="multipart/form-data"><div class="thumb"><% if(p.image){ %><img src="/uploads/<%= p.image %>"><% } else { %>No photo<% } %></div><label>Name<input name="name" value="<%= p.name %>"></label><label>Gender<select name="gender"><option <%= p.gender==='Male'?'selected':'' %>>Male</option><option <%= p.gender==='Female'?'selected':'' %>>Female</option></select></label><label>Age<input name="age" value="<%= p.age %>"></label><label>Price<input name="price" value="<%= p.price %>"></label><label>Status<select name="status"><% ['Available','Reserved','Adopted'].forEach(s=>{ %><option <%= p.status===s?'selected':'' %>><%= s %></option><% }) %></select></label><label>Replace photo<input type="file" name="image" accept="image/*"></label><label class="wide">Description<textarea name="description"><%= p.description %></textarea></label><button class="button" type="submit">Save changes</button></form><form class="delete" action="/admin/puppies/<%= p.id %>/delete" method="post"><button type="submit" onclick="return confirm('Delete this puppy?')">Delete</button></form><% }) %></div></section>
<section class="panel"><h2>Website Pictures</h2><p>These controls let you replace the major photos shown on the public website.</p><div class="image-settings"><% images.forEach(im => { %><form action="/admin/images/<%= im.slot %>" method="post" enctype="multipart/form-data"><h3><%= im.label %></h3><% if(im.image){ %><img src="/uploads/<%= im.image %>" class="sitepreview"><% } else { %><div class="sitepreview placeholder">No image uploaded</div><% } %><input type="file" name="image" accept="image/*" required><button class="button" type="submit">Replace image</button></form><% }) %></div></section></main></body></html>
