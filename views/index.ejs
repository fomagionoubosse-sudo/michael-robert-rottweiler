<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Michael Robert | Rottweiler Breeder</title><link rel="stylesheet" href="/style.css"></head><body>
<header><div class="top">Michael Robert · Rottweiler Breeder <span>917-226-8098</span></div><nav><a class="brand" href="/">MICHAEL ROBERT<small>ROTTWEILER BREEDER</small></a><div class="links"><a href="#puppies">Available Puppies</a><a href="#about">About</a><a href="#process">Our Process</a><a href="#contact">Contact</a><a class="admin" href="/admin/login">Admin Login</a></div></nav></header>
<section class="hero" style="background-image:linear-gradient(90deg,rgba(0,0,0,.86),rgba(0,0,0,.25)),url('<%= images.hero || 'https://images.unsplash.com/photo-1552053831-71594a27632d?auto=format&fit=crop&w=1800&q=80' %>')"><div><p class="eyebrow">RAISED WITH CARE</p><h1>Exceptional Rottweilers,<br><em>Family Ready.</em></h1><p>Dedicated to Raising Exceptional Rottweilers
We are committed to raising healthy, well-socialized Rottweiler puppies in a caring environment. Each puppy receives attentive care and early socialization to help them grow into confident, loving companions. We take pride in providing families with quality puppies and support throughout the adoption process.</p><a class="button" href="#puppies">View Available Puppies</a></div></section>
<section id="puppies" class="section"><div class="section-head"><p class="eyebrow">CURRENT LITTERS</p><h2>Available Rottweiler Puppies</h2><p>Prices and availability are managed from your private admin dashboard.</p></div><div class="grid"><% puppies.forEach(p => { %><article class="card"><% if(p.image){ %><img src="<%= p.image.startsWith('http') ? p.image : '/uploads/'+p.image %>" alt="<%= p.name %>"><% } else { %><div class="placeholder">Puppy photo</div><% } %><div class="cardbody"><span class="badge"><%= p.status %></span><h3><%= p.name %></h3><p><%= p.gender %> · <%= p.age %></p><strong><%= p.price %></strong><a href="/puppy/<%= p.id %>" class="textlink">View puppy →</a></div></article><% }) %></div></section>
<section id="about" class="split"><div class="photo" style="background-image:url('<%= images.about || 'https://images.unsplash.com/photo-1605568427561-40dd23c2acea?auto=format&fit=crop&w=1200&q=80' %>')"></div><div><p class="eyebrow">ABOUT MICHAEL ROBERT</p><h2>A thoughtful start for every puppy.</h2><p>Use this section to tell visitors about your real experience, puppy-raising practices, socialization, veterinary care, and what families can expect.</p><div class="checks"><span>✓ Health records</span><span>✓ Age-appropriate care</span><span>✓ Family-focused placement</span><span>✓ Ongoing communication</span></div></div></section>
<section id="process" class="section light">
  <div class="section-head">
    <p class="eyebrow">ADOPTION PROCESS</p>
    <h2>Simple, transparent, personal.</h2>
  </div>

  <div class="steps">
    <% processSteps.forEach(step => { %>
      <div>
        <b><%= step.step_number %></b>
        <h3><%= step.title %></h3>
        <p><%= step.description %></p>
      </div>
    <% }) %>
  </div>
</section>
<section id="contact" class="contact"><div><p class="eyebrow">GET IN TOUCH</p><h2>Interested in a puppy?</h2><p>Call <strong>917-226-8098</strong> or use your preferred contact method to ask about current availability.</p><a class="button" href="sms:+19172268098?body=Hi%20Michael%20Robert,%20I%27m%20interested%20in%20one%20of%20your%20Rottweiler%20puppies.%20Could%20you%20tell%20me%20more%20about%20the%20available%20puppies%3F">Text Michael Robert</a></div></section>
<footer>© <%= new Date().getFullYear() %> Michael Robert · Rottweiler Breeder <a href="/admin/login">Admin</a></footer>
</body></html>
